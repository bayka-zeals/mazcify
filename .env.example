# ============================================================
# Mazcify — Environment Variables
# ============================================================
# 1. Copy this file:  cp .env.example .env.local
# 2. Fill in your values below
# 3. NEVER commit .env.local — it's in .gitignore
# ============================================================

# ------------------------------------------------------------
# Firebase (client-side — safe to expose with NEXT_PUBLIC_)
# Get these from: Firebase Console → Project Settings → Your Apps
# ------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------
# OpenAI (server-side ONLY — no NEXT_PUBLIC_ prefix)
# Get from: https://platform.openai.com/api-keys
# Used for: website scraping, brand DNA extraction, prompt generation
# ------------------------------------------------------------
OPENAI_API_KEY=

# ------------------------------------------------------------
# PixVerse (server-side ONLY — no NEXT_PUBLIC_ prefix)
# Get from: https://platform.pixverse.ai
# Used for: mascot image generation, video generation
# ------------------------------------------------------------
PIXVERSE_API_KEY=

# ------------------------------------------------------------
# App config (optional overrides)
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
